Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteBase /Shock88/

    # No redirigir archivos y carpetas existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Enviar las solicitudes al enrutador principal
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>